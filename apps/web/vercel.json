{
  "crons": [
    {
      "path": "/api/cron/domains/verify",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/streams/send-link-clicked-webhooks",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/streams/update-click-stats",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/streams/update-workspace-links-usage",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/sync-redis-resources",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/queue/retry",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "app/(ee)/api/cron/**/*.ts": {
      "maxDuration": 600
    }
  }
}
